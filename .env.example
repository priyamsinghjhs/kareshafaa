# Copy to .env and adjust. Every setting can also be passed as an environment variable.
WASL_ENV=dev                      # dev | test | prod
# WASL_DATABASE_URL=postgresql+psycopg://wasl:CHANGE_ME@localhost:5432/wasl   # default: SQLite in ./data
# WASL_SECRET_KEY=                # REQUIRED in prod; in dev a random key is generated into data/.secret_key
WASL_DEMO_LOGINS=true             # role-switcher demo logins; MUST be false in prod
WASL_TOKEN_TTL_MINUTES=480
WASL_SUPPRESSION_THRESHOLD=5      # analytics small-cell suppression
WASL_N_PATIENTS=2000
WASL_SEED=20261120
# ML promotion gates
WASL_MIN_AUC_FLOOR=0.60
WASL_MAX_ECE=0.10
WASL_FAIRNESS_AUC_TOLERANCE=0.05
WASL_FAIRNESS_TPR_TOLERANCE=0.15
# Escalation ladder
WASL_REMINDER_FRACTION=0.5
WASL_CLINICAL_LEAD_AFTER_BREACH_FRACTION=0.5
# Background SLA/escalation job (seconds; 0 disables). With several workers one process is elected.
WASL_SWEEP_INTERVAL_SECONDS=300
WASL_DIRECTOR_AFTER_FRACTION=2.0
