# Copy to .env and adjust. Every setting can also be passed as an environment variable.
KARESHAFAA_ENV=dev                      # dev | test | prod
# KARESHAFAA_DATABASE_URL=postgresql+psycopg://kareshafaa:CHANGE_ME@localhost:5432/kareshafaa   # default: SQLite in ./data
# KARESHAFAA_SECRET_KEY=                # REQUIRED in prod; in dev a random key is generated into data/.secret_key
KARESHAFAA_DEMO_LOGINS=true             # role-switcher demo logins; MUST be false in prod
KARESHAFAA_TOKEN_TTL_MINUTES=480
KARESHAFAA_SUPPRESSION_THRESHOLD=5      # analytics small-cell suppression
KARESHAFAA_N_PATIENTS=2000
KARESHAFAA_SEED=20261120
# ML promotion gates
KARESHAFAA_MIN_AUC_FLOOR=0.60
KARESHAFAA_MAX_ECE=0.10
KARESHAFAA_FAIRNESS_AUC_TOLERANCE=0.05
KARESHAFAA_FAIRNESS_TPR_TOLERANCE=0.15
# Escalation ladder
KARESHAFAA_REMINDER_FRACTION=0.5
KARESHAFAA_CLINICAL_LEAD_AFTER_BREACH_FRACTION=0.5
# Background SLA/escalation job (seconds; 0 disables). With several workers one process is elected.
KARESHAFAA_SWEEP_INTERVAL_SECONDS=300
KARESHAFAA_DIRECTOR_AFTER_FRACTION=2.0
# Public demo safety mode (banner, destructive admin actions off, write rate limit, DB restored from a seed copy
# on start and nightly at 03:00 UAE). Off by default.
# KARESHAFAA_PUBLIC_DEMO=1
# KARESHAFAA_DEMO_WRITE_LIMIT=30
# KARESHAFAA_DEMO_WRITE_WINDOW_S=60
# KARESHAFAA_DEMO_SEED_DB=./data/kareshafaa_demo_seed.db
# KARESHAFAA_DEMO_RESET_HOUR=3
